# Optional. Copy to deploy/.env on the host only if you want the /admin view of
# the signup list. Never commit the real file: this repository is public.
#
# COMPANIONS_SECRET_KEY signs the admin session cookie. Keep it stable, or every
# signed-in device is signed out on the next deploy:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
COMPANIONS_SECRET_KEY=
# The password hash does NOT go here. A Werkzeug hash uses '$' as its field
# separator and Compose interpolates $VAR inside a .env file, which leaves a hash
# that is well-formed, non-empty and wrong. Put it in the data volume instead:
#
#   printf %s 'the-password' | docker exec -i companions python -c \
#     "import sys; from werkzeug.security import generate_password_hash as g; print(g(sys.stdin.read()))" \
#     > /home/ben/companions-data/admin_password_hash
#   chmod 600 /home/ben/companions-data/admin_password_hash
